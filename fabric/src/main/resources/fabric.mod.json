{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contributors": [
    "${contributors}"
  ],
  "contact": {
    "homepage": "${link_home}",
    "sources": "${link_src}",
    "issues": "${link_issues}"
  },
  "license": "${license}",
  "icon": "assets/sophisticated-ping/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "app.jyu.fabric.FabricMain"
    ],
    "client": [
      "app.jyu.fabric.FabricClient"
    ],
    "modmenu": [
      "app.jyu.fabric.integration.ModMenuIntegration"
    ]
  },
  "mixins": [
    "sophisticated-ping.mixins.json",
    {
      "config": "sophisticated-ping.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${fabric_compatible_range}",
    "java": ">=${java_version}"
  },
  "recommends": {
    "modmenu": "*",
    "cloth-config": "*"
  }
}
